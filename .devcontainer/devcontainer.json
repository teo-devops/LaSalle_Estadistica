{
  "name": "LaSalle Estadística",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // El entorno vive fuera de la carpeta montada: así no pisa el .venv del
  // ordenador anfitrión (sus rutas de Python no valen dentro del contenedor).
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
    "UV_LINK_MODE": "copy"
  },

  // Mismo instalador que en local: instala uv y hace `uv sync --locked --group lab`.
  "postCreateCommand": "./instalar.sh",

  // `make lab` dentro del contenedor -> VS Code reenvía el puerto al navegador.
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "JupyterLab", "onAutoForward": "openBrowser" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python"
      }
    }
  },

  // Codespaces: máquina mínima para los SVM/random forest de la sesión 7.
  "hostRequirements": { "cpus": 4, "memory": "8gb" }
}
